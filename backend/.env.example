# Copy this file to .env and fill in real values. Never commit .env.

# Generate one with:
# uv run python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2
CSRF_TRUSTED_ORIGINS=

# sqlite:///db.sqlite3  or  postgres://user:password@localhost:5432/mavuno
DATABASE_URL=sqlite:///db.sqlite3

TIME_ZONE=Africa/Nairobi

# Django admin URL prefix
ADMIN_URL=admin/

MEDIA_URL=/media/
# MEDIA_ROOT=/absolute/path/to/media
# True: Django serves uploaded photos. False: nginx serves MEDIA_ROOT.
SERVE_MEDIA=False

PAGE_SIZE=20
JWT_ACCESS_TOKEN_MINUTES=30
JWT_REFRESH_TOKEN_DAYS=30

# Login/register attempts allowed per IP
AUTH_THROTTLE_RATE=10/min

# Used when DEBUG=False
# Reverse proxies in front of the app (nginx = 1)
NUM_PROXIES=1
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
LOG_LEVEL=INFO

# AI model
AI_MODEL_PATH=ml_models/resnet18_final.pt
# Below this confidence (0-1), /scans/predict/ returns 422 and saves nothing.
AI_CONFIDENCE_THRESHOLD=0.8
AI_TOP_K=3
AI_MAX_UPLOAD_MB=10
# CPU threads per worker (0 = all cores)
AI_TORCH_THREADS=0
